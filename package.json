{
  "name": "anazvara-stockist-finder",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "cli": "tsx apps/scraper/src/cli.ts",
    "db:generate": "pnpm --filter @anazvara/database db:generate",
    "db:migrate": "pnpm --filter @anazvara/database db:migrate",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "check": "pnpm typecheck && pnpm lint && pnpm test"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.5",
    "eslint": "^10.14.0",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.1.0"
  }
}
