# Copy to .env and generate a local secret. Do not commit .env.
#   cp searxng/.env.example searxng/.env
#
# Official template:
# https://github.com/searxng/searxng/blob/master/container/.env.example

# Bind the published port to this Mac only (not the public internet).
SEARXNG_HOST=127.0.0.1

# Host and container port. The Python app expects http://localhost:8888
SEARXNG_PORT=8888

# Overwrites server.secret_key. Generate locally, for example:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
SEARXNG_SECRET=change-me-generate-a-local-secret

# Valkey service name from docker-compose.yml
SEARXNG_VALKEY_URL=valkey://valkey:6379/0
