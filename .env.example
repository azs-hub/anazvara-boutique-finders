# Copy to .env. Every key is optional until its provider is enabled in config.

# SQLite database file
DATABASE_PATH=data/stockists.db

# Paid or quota-limited providers (disabled by default)
GOOGLE_PLACES_API_KEY=
EXA_API_KEY=
TAVILY_API_KEY=

# Self-hosted services
SEARXNG_URL=
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=
